HOST=127.0.0.1
PORT=8000
DEFAULT_PROJECT_PATH=.
MAX_FILE_SIZE_BYTES=10485760
MAX_LINES_PER_READ=1000
ALLOW_SYMLINKS=false

# Write Operations Configuration
