HOST=127.0.0.1
PORT=8000
DEFAULT_PROJECT_PATH=.
MAX_FILE_SIZE_BYTES=10485760
MAX_LINES_PER_READ=1000
ALLOW_SYMLINKS=false

# Access Control & Allowed Roots (SEC-002)
# Central allowlist (defaults both READ_ALLOWED_ROOTS and WRITE_ALLOWED_ROOTS if they are not explicitly set)
ALLOWED_PROJECT_ROOTS=C:\MyProject\SomeRepo;D:\Work\OtherRepo

# Granular Read Allowlist (overrides ALLOWED_PROJECT_ROOTS for reads if set)
READ_ALLOWED_ROOTS=C:\MyProject\SomeRepo;D:\Work\OtherRepo

# Write Operations Configuration
ENABLE_WRITE_TOOLS=true
WRITE_ALLOWED_ROOTS=C:\MyProject\SomeRepo;D:\Work\OtherRepo
MAX_WRITE_SIZE_BYTES=1000000
MAX_EDITS_PER_CALL=50
MAX_DIFF_CHARS=20000
BLOCK_WRITES_TO_IGNORED=true
MAX_FILES_PER_REPLACE=100
REGEX_TIMEOUT_SECONDS=2.0
MAX_REGEX_PATTERN_LENGTH=500

