HOST=127.0.0.1
PORT=8000
DEFAULT_PROJECT_PATH=.
MAX_FILE_SIZE_BYTES=10485760
MAX_LINES_PER_READ=1000
ALLOW_SYMLINKS=false

# Access Control & Allowed Roots (SEC-002)
# Central allowlist (defaults both READ_ALLOWED_ROOTS and WRITE_ALLOWED_ROOTS if they are not explicitly set)
ALLOWED_PROJECT_ROOTS=C:\MyProject\SomeRepo;D:\Work\OtherRepo

# Granular Read Allowlist (overrides ALLOWED_PROJECT_ROOTS for reads if set)
READ_ALLOWED_ROOTS=C:\MyProject\SomeRepo;D:\Work\OtherRepo

# Write Operations Configuration
ENABLE_WRITE_TOOLS=true
WRITE_ALLOWED_ROOTS=C:\MyProject\SomeRepo;D:\Work\OtherRepo
MAX_WRITE_SIZE_BYTES=1000000
MAX_EDITS_PER_CALL=50
MAX_DIFF_CHARS=20000
BLOCK_WRITES_TO_IGNORED=true
MAX_FILES_PER_REPLACE=100
REGEX_TIMEOUT_SECONDS=2.0
MAX_REGEX_PATTERN_LENGTH=500

# ---------------------------------------------------------------
# Git integration
# ---------------------------------------------------------------
ENABLE_GIT_TOOLS=true

# How dangerous git actions (merge, revert, restore) get human approval:
#   auto   = use client elicitation if supported, else approval code on the server console
#   elicit = elicitation only (fails if the client does not support it)
#   code   = approval code printed on the server console only
GIT_CONFIRM_MODE=auto

# Seconds before a pending approval expires
GIT_CONFIRM_TTL_SECONDS=300

# Timeout for a single git command (seconds)
GIT_COMMAND_TIMEOUT_SECONDS=30

# Maximum diff/show lines returned to the LLM
GIT_MAX_DIFF_LINES=2000

# ---------------------------------------------------------------
# Automated verification (build / lint / test)
# ---------------------------------------------------------------
ENABLE_VERIFICATION_TOOLS=true

# Name of the human-edited check config in the served project root
VERIFY_CONFIG_FILENAME=.codescope.toml

# If no config exists, detect checks from pyproject.toml, package.json, Cargo.toml, go.mod
VERIFY_AUTODETECT=true

# Default timeout per check (seconds) and max output kept per stream (characters)
VERIFY_DEFAULT_TIMEOUT_SECONDS=300
VERIFY_MAX_OUTPUT_CHARS=20000

